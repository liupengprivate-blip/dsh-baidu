{
  "name": "dsh-baidu",
  "version": "0.1.0",
  "description": "搜索引擎模拟器 — a simulated search engine panel for DeepSeek Harness, backed by the local DSH web search API (top 10 results).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-baidu",
    "deepseek",
    "harness",
    "search",
    "baidu",
    "demo"
  ],
  "license": "MIT",
  "author": "liupengprivate-blip",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liupengprivate-blip/dsh-baidu.git"
  },
  "homepage": "https://github.com/liupengprivate-blip/dsh-baidu#readme",
  "bugs": {
    "url": "https://github.com/liupengprivate-blip/dsh-baidu/issues"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/requirements.md",
    "docs/publishing.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=22"
  }
}
